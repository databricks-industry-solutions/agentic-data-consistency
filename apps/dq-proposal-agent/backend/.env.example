# Copy to backend/.env and fill in. All keys use the DQ_ prefix
# (Pydantic Settings env_prefix). Required for local dev only — in the
# deployed Databricks App these come from app.yaml + resource bindings.

# Databricks workspace auth — use a CLI profile you have configured
# via `databricks auth login --profile <name>`.
DQ_DATABRICKS_PROFILE=<your-cli-profile>

# Identity mode: "obo" (act as the signed-in user) or "sp" (always the app
# service principal). Locally both resolve to DQ_DATABRICKS_PROFILE unless a
# bearer token is sent. See docs/AUTHORIZATION.md.
DQ_AUTH_MODE=obo

# A SQL warehouse the agent can issue SELECTs against. Must have CAN_USE.
DQ_DATABRICKS_WAREHOUSE_ID=

# Optional: a Genie space ID for NL→SQL authoring. If empty, the agent
# falls back to the hand-authored templates in agent/invariant_catalog.py.
DQ_GENIE_SPACE_ID=

# Where the app stores its state (proposal_run / proposal / acceptance /
# dq_finding / agent_trace_* tables). The schema is created on startup.
DQ_APP_CATALOG=
DQ_APP_SCHEMA=

# Default email recipient when accepting proposals without an override.
DQ_DEFAULT_ALERT_SUBSCRIBERS=

# Workspace folder where created v2 alerts will live. In the deployed
# app this is set to the app SP's home; for local dev your own home is fine.
DQ_ALERT_PARENT_PATH=

# Optional: MLflow experiment path. Traces land in
# <DQ_APP_CATALOG>.<DQ_APP_SCHEMA>.<DQ_MLFLOW_TRACE_TABLE_PREFIX>_* Delta tables.
DQ_MLFLOW_EXPERIMENT_NAME=
DQ_MLFLOW_TRACE_TABLE_PREFIX=agent_trace

