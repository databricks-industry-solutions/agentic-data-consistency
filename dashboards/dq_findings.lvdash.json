{
  "datasets": [
    {
      "name": "findings_detail",
      "displayName": "Findings Detail",
      "queryLines": [
        "SELECT\n",
        "  f.id,\n",
        "  f.invariant_type,\n",
        "  f.target_table_fqn,\n",
        "  f.violations,\n",
        "  f.evaluated_at,\n",
        "  f.resolved,\n",
        "  p.status AS proposal_status,\n",
        "  p.confidence AS proposal_confidence\n",
        "FROM\n",
        "  dq_finding f\n",
        "    LEFT JOIN proposal p\n",
        "      ON f.proposal_id = p.id\n",
        "ORDER BY\n",
        "  f.evaluated_at DESC"
      ]
    },
    {
      "name": "proposal",
      "displayName": "Proposals",
      "queryLines": [
        "SELECT\n",
        "  id,\n",
        "  status,\n",
        "  invariant_type,\n",
        "  confidence,\n",
        "  current_violation_count,\n",
        "  created_at\n",
        "FROM\n",
        "  proposal"
      ]
    },
    {
      "name": "proposal_run",
      "displayName": "Proposal Runs",
      "queryLines": [
        "SELECT\n",
        "  id,\n",
        "  status,\n",
        "  started_at,\n",
        "  completed_at\n",
        "FROM\n",
        "  proposal_run"
      ]
    },
    {
      "name": "dq_finding",
      "displayName": "DQ Findings",
      "queryLines": [
        "SELECT\n",
        "  id,\n",
        "  proposal_id,\n",
        "  invariant_type,\n",
        "  target_table_fqn,\n",
        "  violations,\n",
        "  evaluated_at,\n",
        "  resolved\n",
        "FROM\n",
        "  dq_finding"
      ]
    },
    {
      "name": "approved_proposal",
      "displayName": "Approved Proposals",
      "queryLines": [
        "SELECT\n",
        "  id,\n",
        "  invariant_type,\n",
        "  current_violation_count\n",
        "FROM\n",
        "  proposal\n",
        "WHERE\n",
        "  status = 'APPROVED'"
      ]
    },
    {
      "name": "latest_finding",
      "displayName": "Latest Finding per Approved Proposal",
      "queryLines": [
        "SELECT\n",
        "  f.proposal_id,\n",
        "  f.target_table_fqn,\n",
        "  f.violations,\n",
        "  f.evaluated_at\n",
        "FROM\n",
        "  dq_finding f\n",
        "    JOIN proposal p\n",
        "      ON f.proposal_id = p.id\n",
        "WHERE\n",
        "  p.status = 'APPROVED'\n",
        "QUALIFY\n",
        "  ROW_NUMBER() OVER (PARTITION BY f.proposal_id ORDER BY f.evaluated_at DESC) = 1"
      ]
    }
  ],
